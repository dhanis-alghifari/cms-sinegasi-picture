{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:select-labels": "node --import ./scripts/register-frontend-tsconfig.mjs --import ../backend/node_modules/tsx/dist/loader.mjs scripts/check-select-labels.mjs",
    "check:class-options-contract": "node --import ./scripts/register-frontend-tsconfig.mjs --import ../backend/node_modules/tsx/dist/loader.mjs scripts/check-class-options-contract.mjs",
    "check:attendance-contract": "node --import ./scripts/register-frontend-tsconfig.mjs --import ../backend/node_modules/tsx/dist/loader.mjs scripts/check-attendance-contract.mjs",
    "check:deployment-assets": "node --import ./scripts/register-frontend-tsconfig.mjs --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/deploymentAssets.test.ts tests/deploymentBuild.test.ts tests/productionBuild.test.ts",
    "check:private-media": "node --import ./scripts/register-frontend-tsconfig.mjs --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/privateMedia.test.ts",
    "check:response-limits": "node --import ./scripts/register-frontend-tsconfig.mjs --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/responseLimits.test.ts",
    "check:monitoring": "node --import ./scripts/register-frontend-tsconfig.mjs --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/clientMonitoring.test.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:production": "tsc -b && vite build --mode production-launch",
    "quality:check": "npm run lint && npm run check:api-boundaries && npm run check:feature-boundaries && npm run check:storytelling && npm run check:dialogs && npm run check:form-controls && npm run check:select-labels && npm run check:class-options-contract && npm run check:attendance-contract && npm run check:private-media && npm run check:response-limits && npm run check:monitoring && npm run build && npm run check:deployment-assets && npm run check:bundle",
    "check:api-boundaries": "node scripts/check-api-boundaries.mjs",
    "check:dialogs": "node scripts/check-responsive-dialogs.mjs",
    "check:form-controls": "node scripts/check-form-control-sizes.mjs",
    "check:feature-boundaries": "node scripts/check-feature-boundaries.mjs",
    "check:storytelling": "node scripts/check-storytelling-code.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.28.0",
    "motion": "13.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
