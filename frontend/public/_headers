# JavaScript, CSS and fonts are public build assets. They may be requested from
# the project's stable domain while pinned to a hash-based deployment origin.
/assets/*
  Access-Control-Allow-Origin: *

# Observe policy violations before enforcement; verify the immutable deployment
# origin and API/R2 hosts in staging before changing this to an enforcing CSP.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://sinegasi-dev.duckdns.org https://api.sinegasi.com https://*.r2.cloudflarestorage.com; form-action 'self'
