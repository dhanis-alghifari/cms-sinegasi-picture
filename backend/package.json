{
  "name": "backend",
  "version": "1.0.0",
  "description": "Fastify Backend & Audit Middleware for Sinegasi CMS",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "api:check": "node scripts/validate-openapi.mjs",
    "quality:check": "npm run typecheck && npm test && npm run api:check && npm run build",
    "start": "node dist/server.js",
    "test": "ENV_FILE_LOADING=disabled node --import tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "test:conn": "tsx src/testConnection.ts",
    "db:migrate:grades": "npm run build && node dist/scripts/applyGradesMigration.js",
    "db:migrate:cash": "npm run build && node dist/scripts/applyCashMigration.js",
    "db:migrate:contests": "npm run build && node dist/scripts/applyContestMigration.js",
    "db:migrate": "npm run build && node dist/scripts/applyMigrations.js",
    "db:production:plan": "tsx src/scripts/productionMigrations.ts plan",
    "db:production": "tsx src/scripts/productionMigrations.ts",
    "db:rehearse:runner": "tsx src/scripts/rehearseMigrationRunner.ts",
    "db:production:backup": "tsx src/scripts/productionBackup.ts",
    "db:rehearse:backup": "tsx src/scripts/rehearseProductionBackup.ts",
    "db:reconciliation:plan": "node --import tsx src/scripts/rehearseProductionReconciliation.ts plan",
    "db:reconciliation:rehearse": "node --import tsx src/scripts/rehearseProductionReconciliation.ts rehearse",
    "db:reconciliation:rehearse:fresh": "node --import tsx src/scripts/rehearseFreshProductionSchema.ts rehearse-fresh",
    "db:production:reference:plan": "node --import tsx src/scripts/productionReferenceData.ts plan",
    "db:production:prepare": "npm run typecheck && node --import tsx --test --test-concurrency=1 src/scripts/productionReferenceData.test.ts src/scripts/rehearseFreshProductionSchema.test.ts src/scripts/productionReconciliation.test.ts src/scripts/bootstrapTeacher.test.ts src/scripts/migrationSafety.test.ts && npm run db:production:reference:plan -- --billing-amount 5000",
    "db:production:reference:rehearse": "tsc && node --import tsx src/scripts/rehearseFreshProductionSchema.ts rehearse-reference",
    "db:production:api:rehearse": "tsc && node --import tsx src/scripts/rehearseProductionApi.ts rehearse-api",
    "db:production:integration:plan": "node --import tsx src/scripts/productionManagedIntegration.ts plan",
    "db:production:integration": "node --import tsx src/scripts/productionManagedIntegration.ts",
    "db:reconciliation:preflight:plan": "node --import tsx src/scripts/productionReconciliationPreflight.ts plan",
    "db:reconciliation:preflight": "node --import tsx src/scripts/productionReconciliationPreflight.ts preflight",
    "db:reconciliation:writer:plan": "node --import tsx src/scripts/reconciliationWriter.ts plan",
    "db:reconciliation:writer:inspect": "node --import tsx src/scripts/reconciliationWriter.ts inspect",
    "db:reconciliation:writer": "node --import tsx src/scripts/reconciliationWriter.ts",
    "db:reconciliation:writer:rehearse": "tsc && node --import tsx src/scripts/rehearseReconciliationWriter.ts rehearse-writer",
    "db:backup:copy-vps": "tsx src/scripts/copyEncryptedBackupToVps.ts",
    "db:bootstrap:teacher": "tsx src/scripts/bootstrapTeacher.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.2.4",
    "@supabase/supabase-js": "^2.112.2",
    "fastify": "^5.12.5",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.20.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
